<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CryptSage.Core\CryptSage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <RootNamespace>CryptSage.App</RootNamespace>
    <!-- The one source of the version: the updater compares it and publish.ps1 reads it. -->
    <Version>0.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
    <Resource Include="MountIcon.png" />
  </ItemGroup>

  <!--
    Crypt Sage needs no pen input. Without this switch, WPF loads PenImc_cor3.dll on each
    Windows device-change message, and that load fails in the single-file build.
    Touch taps still work as mouse clicks.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport" Value="true" />
  </ItemGroup>

</Project>
