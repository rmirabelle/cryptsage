<ui:FluentWindow x:Class="CryptSage.App.AboutDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="About Crypt Sage"
                 Width="400" Height="270"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About Crypt Sage" />

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="pack://application:,,,/AppIcon.ico"
                       Width="48" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,16,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Crypt Sage"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText"
                               FontSize="13"
                               Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="0,20,0,0" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="ActionButton"
                           Content="Check for Updates"
                           Margin="0,0,8,0"
                           Click="OnAction" />
                <ui:Button Content="Close"
                           IsCancel="True"
                           Click="OnClose" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
