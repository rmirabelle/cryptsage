<ui:FluentWindow x:Class="CryptSage.App.ExitConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Confirm Close"
                 Width="400" Height="220"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Confirm Close" />

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="MessageText"
                       FontSize="14"
                       TextWrapping="Wrap" />

            <CheckBox Grid.Row="1"
                      x:Name="DismountCheck"
                      Content="Dismount All"
                      IsChecked="True"
                      VerticalAlignment="Top"
                      Margin="0,16,0,0" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Content="Cancel"
                           Margin="0,0,8,0"
                           Click="OnCancel" />
                <ui:Button Content="Exit"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="OnExit" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
