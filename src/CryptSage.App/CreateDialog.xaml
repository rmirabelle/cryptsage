<ui:FluentWindow x:Class="CryptSage.App.CreateDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Create volume"
                 Width="460" Height="360"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Create volume" />

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="File" VerticalAlignment="Center" Margin="0,0,0,8" />
            <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="PathBox"
                        PlaceholderText="Where to save the new volume"
                        IsReadOnly="True"
                        Margin="0,0,8,8" />
            <ui:Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="OnBrowse" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" VerticalAlignment="Center" Margin="0,0,0,8" />
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                      x:Name="SizeCombo"
                      Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,0,8" />
            <ui:PasswordBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                            x:Name="PasswordInput"
                            Margin="0,0,0,8" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Confirm" VerticalAlignment="Center" Margin="0,0,0,8" />
            <ui:PasswordBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                            x:Name="ConfirmInput"
                            Margin="0,0,0,8" />

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                       x:Name="StatusText"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       VerticalAlignment="Top"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <ui:ProgressRing x:Name="Spinner"
                                 Width="20" Height="20"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center" />
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button x:Name="CreateButton"
                           Content="Create"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="OnCreate" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
