<ui:FluentWindow x:Class="CryptSage.App.PasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Password"
                 Width="380" Height="200"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Password" />

        <StackPanel Grid.Row="1" Margin="24,16,24,24" VerticalAlignment="Center">
            <TextBlock x:Name="PromptText" FontSize="14" Margin="0,0,0,8" />
            <ui:PasswordBox x:Name="PasswordInput" FontSize="14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button x:Name="OkButton"
                           Content="OK"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
